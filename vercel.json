{
  "version": 2,
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.webimotagency.com"
        }
      ],
      "destination": "https://webimotagency.com/:path*",
      "permanent": true
    },
    {
      "source": "/services/whatsapp-ai-agent",
      "destination": "/products/whatsapp-ai",
      "permanent": true
    },
    {
      "source": "/services/seo-blog-generator",
      "destination": "/products/seo-blog-ai",
      "permanent": true
    },
    {
      "source": "/services/ai-marketing-analyst",
      "destination": "/products/cleardesk",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
