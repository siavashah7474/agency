{
  "version": 2,
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.webimotagency.com"
        }
      ],
      "destination": "https://webimotagency.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.webimotagency.com"
        }
      ],
      "destination": "https://webimotagency.com/",
      "permanent": true
    },
    {
      "source": "/services/whatsapp-ai-agent",
      "destination": "/products/whatsapp-ai",
      "permanent": true
    },
    {
      "source": "/services/seo-blog-generator",
      "destination": "/products/seo-blog-ai",
      "permanent": true
    },
    {
      "source": "/services/seo",
      "destination": "/products/seo-blog-ai",
      "permanent": true
    },
    {
      "source": "/services/ai-marketing-analyst",
      "destination": "/products/cleardesk",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/systems",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/systems",
      "permanent": true
    },
    {
      "source": "/ai-solutions",
      "destination": "/clinics",
      "permanent": true
    },
    {
      "source": "/who-we-help",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/industries/healthcare",
      "destination": "/clinics",
      "permanent": true
    },
    {
      "source": "/industries/small-business",
      "destination": "/small-business",
      "permanent": true
    },
    {
      "source": "/industries/real-estate",
      "destination": "/small-business",
      "permanent": true
    },
    {
      "source": "/industries/ecommerce",
      "destination": "/small-business",
      "permanent": true
    },
    {
      "source": "/industries/finance-legal",
      "destination": "/small-business",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
